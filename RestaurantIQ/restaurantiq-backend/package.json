{
  "name": "restaurantiq-backend",
  "version": "1.0.0",
  "description": "Backend API for RestaurantIQ",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "seed": "ts-node src/seed.ts",
    "seed:square": "ts-node src/scripts/seedSquareSandbox.ts",
    "seed:doordash": "ts-node src/scripts/seedDoorDashSandbox.ts",
    "migrate": "ts-node src/scripts/migrate.ts up",
    "migrate:status": "ts-node src/scripts/migrate.ts status",
    "migrate:baseline": "ts-node src/scripts/migrate.ts baseline",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@sentry/node": "^10.72.0",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "pg": "^8.23.0",
    "square": "^45.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.2"
  }
}
